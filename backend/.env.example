# Environment Configuration for CivicLens Backend
# Copy this file to .env and update with your values

# Server Configuration
NODE_ENV=development
PORT=5000

# Public backend URL used in API docs metadata (set in production)
# Example: https://api.civiclens.com
API_BASE_URL=

# Demo admin seeding (disable in production)
ENABLE_DEMO_ADMIN_SEED=true
SEED_ADMIN_EMAIL=admin@civiclens.com
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=demo admin

# JWT Secret - IMPORTANT: Change this to a strong secret in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ============================================
# MongoDB Configuration
# ============================================
# Choose ONE of the options below:

# OPTION 1: LOCAL MONGODB (for local development)
# Use this if you have MongoDB running locally on your machine
# Make sure MongoDB is running on your machine (default: localhost:27017)
MONGO_URI=mongodb://localhost:27017/civiclens

# OPTION 2: MONGODB ATLAS (for team collaboration - RECOMMENDED)
# To use MongoDB Atlas instead, comment out the MONGO_URI above and uncomment this:
# Get your connection string from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/civiclens?retryWrites=true&w=majority
# See MONGODB_SETUP.md for detailed instructions
# MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/civiclens?retryWrites=true&w=majority

# ============================================
# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Optional comma-separated frontend allowlist for CORS (staging + production)
# Example: CORS_ALLOWED_ORIGINS=https://app.civiclens.com,https://staging.civiclens.com
CORS_ALLOWED_ORIGINS=

# Require email verification before login
# Set to false only for local testing when SMTP is not configured
REQUIRE_EMAIL_VERIFICATION=true

# ============================================
# Email Verification (Gmail App Password)
# ============================================
# Steps:
# 1) Enable 2-Step Verification on your Google account
# 2) Generate an App Password in Google Account settings
# 3) Use that 16-character App Password as SMTP_PASS (not your Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
EMAIL_FROM="CivicLens <yourgmail@gmail.com>"
APP_NAME=CivicLens

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# NOTE FOR TEAM MEMBERS:
# 1. Copy this file to .env
# 2. Choose either Local MongoDB OR MongoDB Atlas
# 3. Update the MONGO_URI with your database details
# 4. Never commit .env file to git (it contains sensitive data)
# See MONGODB_SETUP.md for detailed setup instructions
# ============================================
